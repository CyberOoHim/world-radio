# Optional CARTO Basemaps API Key (Server-Side Only)
# Stored securely on the server backend. Never prefix with VITE_ to prevent frontend bundle leaks.
# If set, the server proxy (/api/tiles/streets/*) securely authenticates upstream CARTO requests.
# If unset, the server proxy cleanly falls back to high-resolution OpenStreetMap standard tiles (no watermark).
CARTO_API_KEY=

# Application Access Passcode (Server-Side Only)
# Authorizes both protected map tile proxy routes and AI endpoints (/api/ai/*).
# When unset, only the built-in guest passcode ('guest-radio') works for map tiles,
# and AI endpoints remain locked until APP_PASSCODE is configured.
APP_PASSCODE=

# JWT Secret for signing and verifying passcode authorization tokens (HMAC-SHA256)
JWT_SECRET=world-radio-jwt-secret-key-32chars!!

# Gemini API Key (Server-Side Only) for Hybrid AI Station Search & Seed Builder
GEMINI_API_KEY=

# Target AI Tune seed catalog size (default: 6000, valid range: 100-25000)
# Changing this triggers automatic incremental delta sync and embedding updates
# in both `npm run ai:seed` and server startup RAM sync.
SEED_SWEET_SPOT_COUNT=6000

