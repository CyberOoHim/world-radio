# Optional CARTO Basemaps API Key (Server-Side Only)
# Stored securely on the server backend. Never prefix with VITE_ to prevent frontend bundle leaks.
# If set, the server proxy (/api/tiles/streets/*) securely authenticates upstream CARTO requests.
# If unset, the server proxy cleanly falls back to high-resolution OpenStreetMap standard tiles (no watermark).
CARTO_API_KEY=

# Backend Access Passcode (Frontend <-> Backend Auth)
# Required to access protected backend proxy routes and tile endpoints.
# Defaults to 'radio-2026' if unset.
APP_PASSCODE=radio-2026

# JWT Secret for signing and verifying passcode authorization tokens (HMAC-SHA256)
JWT_SECRET=world-radio-jwt-secret-key-32chars!!
